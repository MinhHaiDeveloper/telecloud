{
  "name": "telecloud",
  "version": "1.1.0-beta.5",
  "description": "Hi-res music player with encrypted, unlimited backup to your own Telegram",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run build:asio && npm run build:media && vite build && electron-builder",
    "build:beta": "node scripts/release.js beta",
    "build:release": "node scripts/release.js release",
    "clean": "if exist dist rmdir /s /q dist && if exist dist-electron rmdir /s /q dist-electron",
    "build:asio": "native\\asio\\build.cmd",
    "build:media": "native\\media\\build.cmd"
  },
  "build": {
    "appId": "com.telecloud.app",
    "productName": "TeleCloud",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "out/installer"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mpv.exe",
        "to": "mpv.exe"
      },
      {
        "from": "native/asio/bin/tc-asio.exe",
        "to": "tc-asio.exe"
      },
      {
        "from": "native/media/bin/tc-media.exe",
        "to": "tc-media.exe"
      },
      {
        "from": "native/asio/sdk/LICENSE-ASIO-SDK.txt",
        "to": "LICENSE-ASIO-SDK.txt"
      },
      {
        "from": "mpv.com",
        "to": "mpv.com"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MinhHaiDeveloper",
        "repo": "telecloud"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "TeleCloud-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeleCloud"
    }
  },
  "keywords": [],
  "author": "MinhHaiDeveloper",
  "license": "GPL-3.0-only",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.8",
    "music-metadata": "^11.13.0",
    "node-taglib-sharp": "^6.0.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  }
}
